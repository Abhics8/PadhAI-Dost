# ── Python RAG backend ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
ALLOWED_ORIGINS=http://localhost:3000

# Must match INTERNAL_API_KEY in the root Next.js .env. If unset, the backend
# accepts unauthenticated requests (local dev only — always set in production).
INTERNAL_API_KEY=change-me

# Where persisted FAISS indices and the session map are stored.
INDEX_ROOT=indices
